#!/usr/bin/env bash
# Runs the verification chain, level by level, and prints a pass/fail summary.
#
#   L1  CPU reference (src/cpu)      vs Hugging Face golden data (data/)
#   L2  each HLS kernel (kernels/*)  vs CPU reference      (kernel testbenches)
#   L3  one transformer block from kernels vs CPU reference (tests/block_test)
#   L4  whole model on kernels: generated token IDs vs Hugging Face
#   (L2-L4 run the kernels in TAPA software simulation)
#
#   tests/run_all_tests              all levels (~45 min; the 32-token L4 run is ~30 min)
#   tests/run_all_tests --quick      skip the 32-token L4 run (~16 min)
#   tests/run_all_tests --level 2    only one level (1, 2, 3 or 4)
# Logs: results/test_logs/<test>.log; summary: results/test_summary.md
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/build/bin"
KB="$ROOT/build/kernels"
LOGS="$ROOT/results/test_logs"
mkdir -p "$LOGS"
QUICK=0 LEVEL=all
while [[ $# -gt 0 ]]; do
  case $1 in
    --quick) QUICK=1 ;;
    --level) LEVEL=$2; shift ;;
    *) echo "usage: $0 [--quick] [--level 1|2|3|4]"; exit 2 ;;
  esac
  shift
done
want() { [[ $LEVEL == all || $LEVEL == "$1" ]]; }

names=(); results=(); details=(); secs=()

run() {  # run <name> <command...>
  local name=$1; shift
  local log="$LOGS/$name.log" t0=$SECONDS
  printf '%-30s ' "$name"
  (cd "$ROOT" && "$@") > "$log" 2>&1
  local rc=$? dt=$((SECONDS - t0))
  # last line that states a verdict, for the summary
  local d
  d=$(tr '\r' '\n' < "$log" | grep -E "passed, [0-9]+ failed|match|CPU vs golden" | tail -1 | sed 's/^ *//')
  if [[ $rc -eq 0 ]]; then r=PASS; else r=FAIL; fi
  printf '%s  (%ss)  %s\n' "$r" "$dt" "$d"
  names+=("$name"); results+=("$r"); details+=("$d"); secs+=("$dt")
}

KERNELS=(gemv layernorm gelu residual attention lm_head)
echo "== build (log: results/test_logs/build.log) =="
: > "$LOGS/build.log"
build() { make -s -C "$ROOT/$1" "$2" >> "$LOGS/build.log" 2>&1 || { echo "build failed: $1 $2"; exit 1; }; }
want 1 && build src/cpu cpu_main
if want 2; then for k in "${KERNELS[@]}"; do build "kernels/$k" tb; done; fi
want 3 && build tests block_test
want 4 && build src/host host_main

if want 1; then
  echo "== L1: CPU reference vs Hugging Face =="
  run L1_cpu_vs_hf "$BIN/cpu_main" verify
fi
if want 2; then
  echo "== L2: each kernel vs CPU reference (software simulation) =="
  for k in "${KERNELS[@]}"; do run "L2_kernel_$k" "$KB/$k/tb"; done
fi
if want 3; then
  echo "== L3: one transformer block from kernels vs CPU reference =="
  run L3_block_fused "$BIN/block_test"
  run L3_block_unfused_residual "$BIN/block_test" --unfused
fi
if want 4; then
  echo "== L4: whole model on kernels, token IDs vs Hugging Face =="
  run L4_e2e_8tok_cpu_fallback "$BIN/host_main" --n=8 --check --cpu_ops=attention,gelu
  run L4_e2e_8tok_unfused "$BIN/host_main" --n=8 --check --fuse_residual=false
  if [[ $QUICK -eq 0 ]]; then
    run L4_e2e_32tok_all_kernels "$BIN/host_main" --n=32 --check
  fi
fi

npass=0; nfail=0
{
  echo "# Test summary"
  echo
  echo "Generated by \`tests/run_all_tests\` on $(date -u '+%Y-%m-%d %H:%M UTC') (levels: $LEVEL$([[ $QUICK -eq 1 ]] && echo ', quick')). Logs in \`results/test_logs/\`."
  echo
  echo "| test | result | time (s) | detail |"
  echo "|---|---|---|---|"
  for i in "${!names[@]}"; do
    echo "| ${names[$i]} | ${results[$i]} | ${secs[$i]} | ${details[$i]} |"
  done
} > "$ROOT/results/test_summary.md"
for r in "${results[@]}"; do [[ $r == PASS ]] && npass=$((npass + 1)) || nfail=$((nfail + 1)); done
echo "== summary: $npass passed, $nfail failed (results/test_summary.md) =="
[[ $nfail -eq 0 ]]
